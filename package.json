{
  "name": "portfolio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d --wait",
    "lint": "eslint .",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "update:data": "tsc update-data.ts --outDir dist && node dist/update-data.js",
    "typecheck": "tsc --noEmit",
    "directus:setup": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/directus-setup.mts",
    "prepare": "husky"
  },
  "dependencies": {
    "@directus/sdk": "27.0.0",
    "@sentry/nextjs": "^11.4.0",
    "clsx": "2.1.1",
    "next": "16.4.3",
    "postgres": "3.4.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "10.13.0",
    "eslint-config-next": "16.4.3",
    "husky": "^9.1.7",
    "jsdom": "30.1.3",
    "lint-staged": "^17.0.0",
    "postcss": "8.5.31",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@12.15.0",
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "prettier --write",
      "eslint --fix --max-warnings 0"
    ],
    "*.{md,json}": [
      "prettier --write"
    ]
  }
}
